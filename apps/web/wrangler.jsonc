{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "vars": {
    "APP_URL": "https://artifacts.amar.sh",
    // Overridden on deploy with --var GIT_SHA:<commit>.
    "GIT_SHA": "dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artifacts",
      "database_id": "1977407e-4888-4d78-90d1-3a7949af4387",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "artifacts",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "routes": [{ "pattern": "artifacts.amar.sh", "custom_domain": true }],
}
